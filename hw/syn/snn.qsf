set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY snn
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:15:54  OCTOBER 02, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/common/snn_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/engine/syn_eng.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/engine/snn.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/engine/lif_eng.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/mem/meta_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/mem/conn_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/acc/mem/config_mem.sv
set_global_assignment -name SDC_FILE snn.sdc
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to init
set_instance_assignment -name VIRTUAL_PIN ON -to spikesIn*
set_instance_assignment -name VIRTUAL_PIN ON -to spikesOut*
set_instance_assignment -name VIRTUAL_PIN ON -to snn_done
set_instance_assignment -name VIRTUAL_PIN ON -to num_layers*
set_instance_assignment -name VIRTUAL_PIN ON -to config_*
set_instance_assignment -name VIRTUAL_PIN ON -to neuron_meta_*
set_instance_assignment -name VIRTUAL_PIN ON -to layer_meta_*
set_instance_assignment -name VIRTUAL_PIN ON -to conn_*
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top