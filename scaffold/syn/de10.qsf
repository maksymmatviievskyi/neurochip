# DE10-Lite live gesture classifier (top: scaffold/rtl/de10_top.sv)
# Open de10.qpf in Quartus, compile, program output_files/de10.sof with the Programmer.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
# Keep the $readmemh ROM contents when the design is written to the on-chip flash (.pof).
# Same as Device and Pin Options > Configuration > "Single Uncompressed Image with Memory Initialization".
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"

# ---------------- sources (package first) ----------------
# ../../rtl = your design, ../rtl = scaffold
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/snn_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/mem/config_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/mem/conn_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/mem/meta_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/engine/syn_eng.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/engine/lif_eng.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/engine/snn.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/dencode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/spike_record.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/spi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/seq.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/byte_assmbl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/acc/peripheral/master.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/snn_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/readout.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/class_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de10_top.sv
set_global_assignment -name SDC_FILE de10.sdc

